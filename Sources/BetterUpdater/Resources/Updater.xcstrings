    "The update has been downloaded. Please drag the new %@ app to your Applications folder to complete the installation.\n\nAfter installation, restart %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Update wurde heruntergeladen. Bitte ziehe die neue %@-App in deinen Programme-Ordner, um die Installation abzuschließen.\n\nStarte %@ nach der Installation neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The update has been downloaded. Please drag the new %@ app to your Applications folder to complete the installation.\n\nAfter installation, restart %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actualización se ha descargado. Arrastra la nueva app %@ a tu carpeta de Aplicaciones para completar la instalación.\n\nDespués de la instalación, reinicia %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour a été téléchargée. Veuillez glisser la nouvelle application %@ dans votre dossier Applications pour terminer l'installation.\n\nAprès l'installation, redémarrez %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aggiornamento è stato scaricato. Trascina la nuova app %@ nella cartella Applicazioni per completare l'installazione.\n\nDopo l'installazione, riavvia %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De update is gedownload. Sleep de nieuwe %@-app naar je map Programma's om de installatie te voltooien.\n\nStart %@ opnieuw na de installatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizacja została pobrana. Przeciągnij nową aplikację %@ do folderu Aplikacje, aby zakończyć instalację.\n\nPo instalacji uruchom ponownie %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新已下载。请将新的 %@ 应用拖到应用程序文件夹以完成安装。\n\n安装后，请重新启动 %@。"
          }
        },
